{
	"$schema" : "https://schemas.wp.org/trunk/theme.json",
	"version" : 2,

	"docBlock" : {
		"//":"When you see this, it is a custom comment.",

		"@since"   : "1.0.0",
		"@version" : "2.0.4"
	},

	"settings" : {
		"useRootPaddingAwareAlignments" : true,
		"appearanceTools" : true,
		"layout" : {
			"contentSize" : "var(--theme--mod--layout_width_content)",
			"wideSize"    : "var(--theme--mod--layout_width_wide)"
		},
		"color" : {
			"link" : true,
			"palette" : [

				{
					"name"  : "Base (Background)",
					"slug"  : "base",
					"color" : "var(--theme-mod)"
				},

				{
					"name"  : "Contrast (Text)",
					"slug"  : "contrast",
					"color" : "var(--theme-mod)"
				},
				{
					"name"  : "Contrast alternative (Headings)",
					"slug"  : "contrast-alt",
					"color" : "var(--theme-mod)"
				},

				{
					"name"  : "Primary",
					"slug"  : "primary",
					"color" : "var(--theme-mod)"
				},
				{
					"name"  : "Secondary",
					"slug"  : "secondary",
					"color" : "var(--theme-mod)"
				},

				{
					"name"  : "Primary mixed",
					"slug"  : "primary-mixed",
					"color" : "var(--theme-mod)"
				},
				{
					"name"  : "Secondary mixed",
					"slug"  : "secondary-mixed",
					"color" : "var(--theme-mod)"
				},

				{
					"name"  : "Base alternative (Background)",
					"slug"  : "base-alt",
					"color" : "var(--theme-mod)"
				},

				{
					"name"  : "Black",
					"slug"  : "black",
					"color" : "var(--theme-mod)"
				},
				{
					"name"  : "White",
					"slug"  : "white",
					"color" : "var(--theme-mod)"
				}
			],
			"gradients" : [

				{
					"name"     : "Primary to secondary",
					"slug"     : "primary-to-secondary",
					"gradient" : "linear-gradient( 135deg, var(--wp--preset--color--primary), var(--wp--preset--color--secondary) )"
				},
				{
					"name"     : "Secondary to primary",
					"slug"     : "secondary-to-primary",
					"gradient" : "linear-gradient( 135deg, var(--wp--preset--color--secondary), var(--wp--preset--color--primary) )"
				},

				{
					"name"     : "For backdrop blur, dark",
					"slug"     : "backdrop-blur-dark",
					"gradient" : "linear-gradient( rgba(17,17,17,var(--wp--custom--opacity--semitransparent)), rgba(17,17,17,var(--wp--custom--opacity--semitransparent)) )"
				},
				{
					"name"     : "For backdrop blur, light",
					"slug"     : "backdrop-blur-light",
					"gradient" : "linear-gradient( rgba(238,238,238,var(--wp--custom--opacity--semitransparent)), rgba(238,238,238,var(--wp--custom--opacity--semitransparent)) )"
				}
			],
			"duotone" : [

				{
					"name"   : "Base",
					"slug"   : "base",
					"colors" : [
						"base",
						"contrast-alt"
					]
				},
				{
					"name"   : "Contrast",
					"slug"   : "contrast-alt",
					"colors" : [
						"contrast-alt",
						"base"
					]
				},

				{
					"name"   : "Primary",
					"slug"   : "primary",
					"colors" : [
						"primary",
						"?"
					]
				},
				{
					"name"   : "Secondary",
					"slug"   : "secondary",
					"colors" : [
						"secondary",
						"?"
					]
				},

				{
					"name"   : "Primary, secondary",
					"slug"   : "primary-secondary",
					"colors" : [
						"primary",
						"secondary"
					]
				},
				{
					"name"   : "Secondary, primary",
					"slug"   : "secondary-primary",
					"colors" : [
						"secondary",
						"primary"
					]
				},

				{
					"name"   : "Black",
					"slug"   : "black",
					"colors" : [
						"#000000",
						"#ffffff"
					]
				},
				{
					"name"   : "White",
					"slug"   : "white",
					"colors" : [
						"#ffffff",
						"#000000"
					]
				},
				{
					"name"   : "Gray",
					"slug"   : "gray",
					"colors" : [
						"#2a2a2a",
						"#eeeeee"
					]
				}
			]
		},
		"shadow" : {
			"defaultPresets" : true,
			"presets"        : [
				{
					"name"   : "Small",
					"slug"   : "s",
					"shadow" : "0 .15em .5em rgba(0,0,0,.1)"
				},
				{
					"name"   : "Medium",
					"slug"   : "m",
					"shadow" : "0 .25em 1em rgba(0,0,0,.15)"
				},
				{
					"name"   : "Large",
					"slug"   : "l",
					"shadow" : "0 .5em 2em rgba(0,0,0,.2)"
				},
				{
					"name"   : "Inset",
					"slug"   : "inset-m",
					"shadow" : "inset 0 .25em 1em rgba(0,0,0,.2)"
				}
			]
		},
		"border" : {
			"width"  : true,
			"style"  : true,
			"color"  : true,
			"radius" : true,
			"radiusSizes" : [
				{
					"name" : "Small",
					"slug" : "s",
					"size" : "var(--wp--custom--border-radius--s)"
				},
				{
					"name" : "Medium",
					"slug" : "m",
					"size" : "var(--wp--custom--border-radius--m)"
				},
				{
					"name" : "Large",
					"slug" : "l",
					"size" : "var(--wp--custom--border-radius--l)"
				},
				{
					"name" : "X Large",
					"slug" : "xl",
					"size" : "var(--wp--custom--border-radius--xl)"
				}
			]
		},
		"spacing" : {
			"blockGap" : true,
			"padding"  : true,
			"margin"   : true,
			"spacingSizes" : [
				{
					"name" : "X Small",
					"slug" : "xs",
					"size" : ".5rem"
				},
				{
					"name" : "Small",
					"slug" : "s",
					"size" : "clamp( .5rem, .5rem + 100vw / ( 1280 / ( .5 * 16 ) ), 2 * .5rem )"
				},
				{
					"name" : "Medium",
					"slug" : "m",
					"size" : "clamp( 1rem, 1rem + 100vw / ( 1280 / ( 1 * 16 ) ), 2 * 1rem )"
				},
				{
					"name" : "Large",
					"slug" : "l",
					"size" : "clamp( 1.5rem, 1.5rem + 100vw / ( 1280 / ( 1.5 * 16 ) ), 2 * 1.5rem )"
				},
				{
					"name" : "X Large",
					"slug" : "xl",
					"size" : "clamp( 2rem, 2rem + 100vw / ( 1280 / ( 2 * 16 ) ), 2 * 2rem )"
				},
				{
					"name" : "2X Large",
					"slug" : "xxl",
					"size" : "clamp( 2.5rem, 2.5rem + 100vw / ( 1280 / ( 2.5 * 16 ) ), 2 * 2.5rem )"
				},
				{
					"name" : "Content padding",
					"slug" : "content",
					"size" : "clamp( 50px, 50px + ( ( 100 - 50 ) * ( 100vw - var(--theme--css--vw-s) * 1px ) / ( var(--theme--css--vw-l) - var(--theme--css--vw-s) ) ), 100px )"
				}
			],
			"units" : [
				"%",
				"em",
				"rem",
				"px",
				"vh",
				"vw",
				"vmin",
				"vmax",
				"svh",
				"lvh",
				"dvh"
			],
			"defaultSpacingSizes" : false
		},
		"dimensions" : {
			"aspectRatios" : [
				{
					"name"  : "Golden - 1.618:1",
					"slug"  : "golden",
					"ratio" : "1.618/1"
				},
				{
					"name"  : "Golden Portrait - 1:1.618",
					"slug"  : "golden-portrait",
					"ratio" : "1/1.618"
				},
				{
					"name"  : "Silver - 2.414:1",
					"slug"  : "silver",
					"ratio" : "2.414/1"
				},
				{
					"name"  : "Ultrawide - 21:9",
					"slug"  : "21-9",
					"ratio" : "21/9"
				},
				{
					"name"  : "Super Ultrawide - 32:9",
					"slug"  : "32-9",
					"ratio" : "32/9"
				}
			]
		},
		"typography" : {
			"defaultFontSizes" : false,
			"lineHeight"       : true,
			"textColumns"      : true,
			"textIndent"       : true,
			"writingMode"      : true,
			"fontFamilies" : [
				{
					"name"       : "Main",
					"slug"       : "global",
					"fontFamily" : "var(--theme--mod--typography_font_family_global)"
				},
				{
					"name"       : "Heading",
					"slug"       : "supplemental",
					"fontFamily" : "var(--theme--mod--typography_font_family_supplemental)"
				},
				{
					"name"       : "Alternative",
					"slug"       : "alternative",
					"fontFamily" : "var(--theme--mod--typography_font_family_alternative)"
				},
				{
					"name"       : "Monospace",
					"slug"       : "monospace",
					"fontFamily" : "var(--wp--custom--font-family--monospace-code)"
				},
				{
					"name"       : "Handwritten",
					"slug"       : "handwritten",
					"fontFamily" : "var(--wp--custom--font-family--handwritten)"
				},
				{
					"name"       : "Ubuntu Sans",
					"slug"       : "ubuntu-sans",
					"fontFamily" : "'Ubuntu Sans', sans-serif",
					"fontFace"   : [
						{
							"fontFamily"  : "Ubuntu Sans",
							"fontStretch" : "normal",
							"fontStyle"   : "normal",
							"fontWeight"  : "300 700",
							"src"         : [
								"file:./assets/fonts/ubuntu-sans/ubuntu-sans-variable.woff2"
							]
						}
					]
				},
				{
					"name"       : "Unica One",
					"slug"       : "unica-one",
					"fontFamily" : "'Unica One', sans-serif",
					"fontFace"   : [
						{
							"fontFamily"  : "Unica One",
							"fontStretch" : "normal",
							"fontStyle"   : "normal",
							"fontWeight"  : "400",
							"src"         : [
								"file:./assets/fonts/unica-one/unica-one-regular.woff2"
							]
						}
					]
				}
			],
			"fontSizes" : [
				{
					"name" : "X Small",
					"slug" : "xs",
					"size" : ".8125em"
				},
				{
					"name" : "Small",
					"slug" : "s",
					"size" : ".875em"
				},
				{
					"name" : "Medium",
					"slug" : "m",
					"size" : "1em"
				},
				{
					"name" : "Large",
					"slug" : "l",
					"size" : "calc( pow( var(--theme--mod--typography_modular_scale), 1 ) * 1em )"
				},
				{
					"name" : "X Large",
					"slug" : "xl",
					"size" : "calc( pow( var(--theme--mod--typography_modular_scale), 2 ) * 1em )"
				},
				{
					"name" : "2X Large",
					"slug" : "xxl",
					"size" : "calc( pow( var(--theme--mod--typography_modular_scale), 3 ) * 1em )"
				},
				{
					"name" : "3X Large",
					"slug" : "xxxl",
					"size" : "calc( pow( var(--theme--mod--typography_modular_scale), 4 ) * 1em )"
				},

				{
					"name" : "Big",
					"slug" : "big",
					"size" : "clamp( 2rem, 5.1vw, 4rem )"
				},
				{
					"name" : "Giant",
					"slug" : "giant",
					"size" : "clamp( 2.5rem, 6.4vw, 5rem )"
				},
				{
					"name" : "Mega",
					"slug" : "mega",
					"size" : "clamp( 3rem, 7.7vw, 6rem )"
				},

				{
					"name" : "Heading 1",
					"slug" : "h-1",
					"size" : "var(--theme--css--font-size-h1)"
				},
				{
					"name" : "Heading 2",
					"slug" : "h-2",
					"size" : "var(--theme--css--font-size-h2)"
				},
				{
					"name" : "Heading 3",
					"slug" : "h-3",
					"size" : "var(--theme--css--font-size-h3)"
				},
				{
					"name" : "Heading 4",
					"slug" : "h-4",
					"size" : "var(--theme--css--font-size-h4)"
				}
			]
		},
		"custom" : {
			"accent-color" : "var(--wp--preset--color--primary)",
			"border-color" : {
				"global" : "color-mix( in srgb, currentColor calc( 100% * var(--wp--custom--opacity--border) ), transparent )",

				"button" : "transparent",
				"hr"     : "var(--wp--custom--border-color--global)"
			},
			"border-radius" : {
				"s"  : ".382rem",
				"m"  : "1rem",
				"l"  : "1.618rem",
				"xl" : "2rem",

				"global" : "var(--wp--custom--border-radius--s)",

				"avatar"     : "var(--wp--custom--border-radius--global)",
				"bg"         : "0",
				"button"     : "var(--wp--custom--border-radius--global)",
				"details"    : "var(--wp--custom--border-radius--global)",
				"form-field" : "var(--wp--custom--border-radius--global)",
				"image"      : "var(--wp--custom--border-radius--global)",
				"sub-menu"   : "var(--wp--custom--border-radius--global)"
			},
			"border-width" : {
				"global" : "2px",

				"dropcap"        : "1px",
				"fieldset"       : "1px",
				"hr"             : "var(--wp--custom--border-width--global)",
				"item-separator" : "1px",
				"table"          : "1px"
			},
			"button" : {
				"border" : {
					"color"         : "var(--wp--custom--border-color--button)",
					"radius"        : "var(--wp--custom--border-radius--button)",
					"style"         : "solid",
					"width"         : "var(--wp--custom--border-width--global)",
					"width-outline" : "var(--wp--custom--border-width--global)"
				},
				"shadow" : {
					"default" : "var(--wp--preset--shadow--s)",
					"hover"   : "var(--wp--preset--shadow--m)",
					"focus"   : "var(--wp--preset--shadow--m)",
					"active"  : "none"
				},
				"transition" : {
					"delay"           : "0s",
					"duration"        : ".1s, .1s, .1s, .4s, .1s, .1s, .1s",
					"property"        : "transform, background-color, background-image, background-size, color, border, box-shadow",
					"timing-function" : "linear"
				}
			},
			"details" : {
				"border" : {
					"color"  : "currentColor",
					"radius" : "var(--wp--custom--border-radius--details)",
					"style"  : "solid",
					"width"  : "var(--wp--custom--border-width--global)"
				},
				"color"   : {
					"background" : "transparent",
					"text"       : "inherit"
				},
				"gap"     : "var(--wp--preset--spacing--s)",
				"padding" : {
					"top"    : "var(--wp--preset--spacing--s)",
					"right"  : "var(--wp--preset--spacing--m)",
					"bottom" : "var(--wp--preset--spacing--s)",
					"left"   : "var(--wp--preset--spacing--m)"
				},
				"summary" : {
					"decoration" : {
						"opacity" : 1
					},
					"focus-visible" : {
						"outline" : {
							"style" : "none"
						},
						"border" : {
							"bottom" : "var(--wp--custom--border-width--global) solid"
						}
					}
				}
			},
			"filter" : {
				"blur" : {
					"backdrop"     : ".618rem",
					"backdrop-alt" : ".382rem",
					"image"        : "1.618rem",
					"video"        : "1rem"
				}
			},
			"font-family" : {
				"geometric-humanist"   : "Avenir, Montserrat, Corbel, 'URW Gothic', source-sans-pro, sans-serif",
				"handwritten"          : "'Segoe Print', 'Bradley Hand', Chilanka, TSCu_Comic, casual, cursive",
				"industrial"           : "Bahnschrift, 'DIN Alternate', 'Franklin Gothic Medium', 'Nimbus Sans Narrow', sans-serif-condensed, sans-serif",
				"monospace-code"       : "ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace",
				"monospace-slab-serif" : "'Nimbus Mono PS', 'Courier New', monospace",
				"slab-serif"           : "Rockwell, 'Rockwell Nova', 'Roboto Slab', 'DejaVu Serif', 'Sitka Small', serif",
				"system-ui"            : "system-ui, sans-serif",
				"transitional"         : "Charter, 'Bitstream Charter', 'Sitka Text', Cambria, serif"
			},
			"font-size" : {
				"navigation" : {
					"mobile" : {
						"top-level" : "var(--wp--preset--font-size--h-3)"
					}
				}
			},
			"hr" : {
				"border-width" : "var(--wp--custom--border-width--hr)",
				"dashed" : {
					"color" : "var(--wp--custom--border-color--hr)"
				},
				"dotted" : {
					"color" : "var(--wp--custom--border-color--hr)"
				}
			},
			"letter-spacing" : {
				"global" : "0",

				"button"  : "var(--wp--custom--letter-spacing--global)",
				"heading" : "var(--wp--custom--letter-spacing--global)",
				"label"   : "var(--wp--custom--letter-spacing--global)",
				"logo"    : "var(--wp--custom--letter-spacing--global)",
				"meta"    : "var(--wp--custom--letter-spacing--global)",
				"plugin"  : "var(--wp--custom--letter-spacing--global)"
			},
			"mark" : {
				"border-radius" : ".38rem",
				"color"         : "currentColor",
				"opacity"       : "20%",
				"padding"       : "0 .1em",
				"padding-bg"    : ".1em .25em"
			},
			"navigation" : {
				"mobile" : {
					"menu-gap" : ".618rem"
				},
				"submenu" : {
					"padding" : {
						"item" : ".382rem"
					},
					"separator" : {
						"width" : "var(--wp--custom--border-width--item-separator)",
						"style" : "dotted"
					}
				}
			},
			"opacity" : {
				"border"             : ".6",
				"pseudo-bg"          : ".05",
				"semitransparent"    : ".5",
				"navigation-overlay" : ".9"
			},
			"pull" : {
				"s" : "calc( -.5 * var(--wp--preset--spacing--content) )",
				"m" : "calc( -.75 * var(--wp--preset--spacing--content) )",
				"l" : "calc( -1 * var(--wp--preset--spacing--content) )"
			},
			"quote" : {
				"cite-before" : "'— ' / ''",
				"color" : {
					"text" : "var(--wp--preset--color--contrast-alt)"
				},
				"decoration"  : {
					"content"     : "var(--theme--css--quote-decoration-content) / ''",
					"font-family" : "var(--wp--custom--font-family--monospace-code)",
					"font-size"   : "3em",
					"opacity"     : "1"
				},
				"font-family" : "var(--wp--preset--font-family--alternative)",
				"font-size"   : "var(--wp--preset--font-size--l)",
				"line-height" : "1.382"
			},
			"shadow" : {
				"sub-menu" : "var(--wp--preset--shadow--m)"
			},
			"spacing" : {
				"gap" : {
					"media-text" : {
						"m" : "clamp( 1rem, 1rem + 100vw / ( 1600 / ( 1 * 16 ) ), 2 * 1rem )",
						"l" : "clamp( 1rem, 1rem + 100vw / ( 1600 / ( 2 * 16 ) ), 3 * 1rem )"
					}
				},
				"has-background" : {
					"top"    : "var(--wp--preset--spacing--m)",
					"right"  : "var(--wp--preset--spacing--m)",
					"bottom" : "var(--wp--preset--spacing--m)",
					"left"   : "var(--wp--preset--spacing--m)"
				},
				"heading"        : "var(--wp--preset--spacing--xl)",
				"input-vertical" : ".5em",
				"menu-mobile"    : {
					"top"    : {
						"m" : "max( 5em, 25vh )",
						"l" : "max( 5em, 40vh )"
					},
					"bottom" : {
						"m" : "max( 5em, 25vh )",
						"l" : "max( 5em, 40vh )"
					}
				}
			},
			"text-wrap" : {
				"heading"   : "balance",
				"paragraph" : "pretty"
			},
			"underline" : {
				"thickness" : "1px",
				"offset" : {
					"default" : ".25em",
					"heading" : ".15em"
				}
			},
			"option-toggle" : {
				"content-space" : "1"
			}
		}
	},

	"styles" : {
		"color" : {
			"background" : "var(--wp--preset--color--base)",
			"text"       : "var(--wp--preset--color--contrast)"
		},
		"border" : {
			"color" : "var(--wp--custom--border-color--global)"
		},
		"spacing" : {
