					"textTransform" : "uppercase",
					"letterSpacing" : "var(--wp--custom--letter-spacing--label)"
				}
			},

			"button" : {
				"//":"v2.0.1: Well, after thorough thinking and some experiments with different approaches (such as setting up button styles via Button block settings), it's better to keep the WordPress way: global button styles are separated from Button block styles. It's future proof and avoids confusion - actually, it leaves responsibility for confusion on WordPress, and we are not adding another layer of confusion here. But we also set global button selectors on Button block, so it is possible to style buttons globally there if needed (@see Content/Block_Mods::settings()->core/button) as Button block contains more user interface options for styling. (@see Content/Block_Mods::button_css_selectors())",

				"color" : {
					"//":"v2.0.1: WordPress' `background-color` style is overridden in CSS with `background:`. (@see assets/scss/custom/_button.scss)",

					"background" : "var(--theme--css--button--color--background)",
					"text"       : "var(--theme--css--button--color--text)"
				},
				"typography" : {
					"fontFamily"     : "var(--wp--preset--font-family--global)",
					"fontSize"       : "var(--wp--preset--font-size--s)",
					"fontWeight"     : "700",
					"letterSpacing"  : "var(--wp--custom--letter-spacing--button)",
					"lineHeight"     : "1.25",
					"textTransform"  : "uppercase",
					"textAlign"      : "center",
					"textDecoration" : "none"
				},
				"spacing" : {
					"padding"  : {
						"top"    : "1.125em",
						"right"  : "1.5em",
						"bottom" : "1.125em",
						"left"   : "1.5em"
					}
				},
				"border" : {
					"//":"v2.0.1: The border color value here is correct! Check `assets/scss/_variables/_others.scss` for explanation.",

					"color"  : "var(--theme--css--button--color--border)",
					"radius" : "var(--wp--custom--button--border--radius)",
					"style"  : "var(--wp--custom--button--border--style)",
					"width"  : "var(--wp--custom--button--border--width)"
				},
				"shadow" : "var(--wp--custom--button--shadow--default)",
				":hover" : {
					"typography" : {
						"textDecoration" : "underline"
					},
					"shadow" : "var(--wp--custom--button--shadow--hover)"
				},
				":focus" : {
					"typography" : {
						"textDecoration" : "underline"
