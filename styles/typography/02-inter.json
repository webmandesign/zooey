{
	"$schema" : "https://schemas.wp.org/trunk/theme.json",
	"version" : 2,
	"title"   : "Inter",

	"docBlock" : {
		"@since" : "2.0.0"
	},

	"settings" : {
		"typography" : {
			"fontFamilies" : [
				{
					"name"       : "Main",
					"slug"       : "global",
					"fontFamily" : "Inter, sans-serif",
					"fontFace"   : [
						{
							"fontFamily"  : "Inter",
							"fontStretch" : "normal",
							"fontStyle"   : "normal",
							"fontWeight"  : "300 400 700",
							"src"         : [
								"file:./assets/fonts/inter/inter-variable.woff2"
							]
						}
					]
				},
				{
					"name"       : "Heading",
					"slug"       : "supplemental",
					"fontFamily" : "var(--wp--preset--font-family--global)"
				},
				{
					"name"       : "Alternative",
					"slug"       : "alternative",
					"fontFamily" : "var(--wp--preset--font-family--global)"
				},
				{
					"name"       : "Monospace",
					"slug"       : "monospace",
					"fontFamily" : "var(--wp--custom--font-family--monospace-code)"
				},
				{
					"name"       : "Handwritten",
					"slug"       : "handwritten",
					"fontFamily" : "var(--wp--custom--font-family--handwritten)"
				}
			]
		}
	}
}
