{
	"$schema" : "https://schemas.wp.org/trunk/theme.json",
	"version" : 2,
	"title"   : "Industrial + Transitional (ModernFontStacks.com)",

	"docBlock" : {
		"@since" : "2.0.0",
		"@link"  : "https://modernfontstacks.com/"
	},

	"settings" : {
		"typography" : {
			"fontFamilies" : [
				{
					"name"       : "Main",
					"slug"       : "global",
					"fontFamily" : "var(--wp--custom--font-family--transitional)"
				},
				{
					"name"       : "Heading",
					"slug"       : "supplemental",
					"fontFamily" : "var(--wp--custom--font-family--industrial)"
				},
				{
					"name"       : "Alternative",
					"slug"       : "alternative",
					"fontFamily" : "var(--wp--preset--font-family--supplemental)"
				},
				{
					"name"       : "Monospace",
					"slug"       : "monospace",
					"fontFamily" : "var(--wp--custom--font-family--monospace-code)"
				},
				{
					"name"       : "Handwritten",
					"slug"       : "handwritten",
					"fontFamily" : "var(--wp--custom--font-family--handwritten)"
				}
			]
		}
	}
}
